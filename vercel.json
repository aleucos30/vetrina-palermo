{
  "regions": ["fra1"],
  "rewrites": [
    { "source": "/p/:city/:slug", "destination": "/m.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
